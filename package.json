{
  "name": "@yamb/core",
  "version": "1.0.0",
  "description": "Editable posts, lazy collections and extension APIs for Yamb",
  "keywords": [
    "blog",
    "cms",
    "esm",
    "markdown",
    "post",
    "yamb"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamb/yamb.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./constants": "./src/constants/index.js",
    "./errors": "./src/errors/index.js",
    "./schemas": "./src/schemas/zod.js",
    "./package.json": "./package.json",
    "./url": "./src/url.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
